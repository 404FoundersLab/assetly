# =============================================================================
# Organization ERP deployment (URL shared inside the company)
# =============================================================================
# Use this profile when the live app is used by employees â€” not a public demo.
# Anyone with the URL can reach the login page, so treat it like production:
#   - DEMO_AUTH_ENABLED must stay false/unset (no Try Demo / Demo@123456)
#   - Strong JWT_SECRET + AGENT_SECRET required
#   - ALLOWED_ORIGIN / APP_URL must match your real app URL
#   - Create real users in the DB (admins invite employees; password required)
#
# Neon or Supabase Postgres (server-side only â€” set in Vercel)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# REQUIRED â€” generate: openssl rand -base64 32
# Min 32 bytes of randomness (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=change-me-in-production
# AES-256-GCM key for TOTP secrets at rest (min 32 bytes; base64 of 32 random bytes)
APP_ENCRYPTION_KEY=change-me-in-production
# Optional: requests per minute per user/IP for the general API limiter (default 300)
# API_RATE_LIMIT_PER_MIN=300

# Your live app origin (CORS). Example: https://assets.yourcompany.com
ALLOWED_ORIGIN=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app

# REQUIRED in production â€” agent registration/telemetry
# Generate: openssl rand -base64 32
AGENT_SECRET=change-me-in-production

# Keep these OFF for organization ERP (employees use real accounts)
DEMO_AUTH_ENABLED=false
BILLING_DEMO_MODE=false

# â”€â”€ Optional â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Neon branch auto-provisioning (dedicated DB per tenant)
# NEON_API_KEY=your-neon-personal-access-token
# NEON_PROJECT_ID=your-neon-project-id

# Supabase Storage for asset images
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Chatbot (Gemini â€” free AI Studio key)
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-2.5-flash-lite
# Optional embedding model for RAG (default: text-embedding-004, 768-d, free)
# GEMINI_EMBED_MODEL=text-embedding-004
# Enable pgvector table once: npm run migrate:rag

# Billing (set real keys when you charge tenants; leave demo mode false above)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# RAZORPAY_PLAN_STARTER=plan_...
# RAZORPAY_PLAN_PROFESSIONAL=plan_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PROFESSIONAL=price_...
# BILLING_INR_USD_RATE=83

# =============================================================================
# Portfolio / recruiter preview (safe read-only guest)
# =============================================================================
# Enables guest@assetly.demo â€” viewer role, writes blocked on the API.
# Do NOT set DEMO_AUTH_ENABLED=true on a public URL (that unlocks admin Demo@123456).
PORTFOLIO_GUEST_ENABLED=true
# Optional overrides:
# PORTFOLIO_GUEST_EMAIL=guest@assetly.demo
# PORTFOLIO_GUEST_PASSWORD=ViewOnly@2026
# PORTFOLIO_GUEST_TENANT_ID=   (defaults to the first tenant)

# Full demo admin accounts â€” local only, never on a public deployment
# DEMO_AUTH_ENABLED=true
# BILLING_DEMO_MODE=true
# VITE_DEMO_AUTH=true   (in apps/web/.env)
