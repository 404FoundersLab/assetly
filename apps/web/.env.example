# Enable Postgres backend (Neon / Supabase)
VITE_USE_API=true

# Organization ERP: leave VITE_DEMO_AUTH unset/false (no admin Try Demo)
# Portfolio read-only guest is controlled by API PORTFOLIO_GUEST_ENABLED
# VITE_PORTFOLIO_GUEST=true   # optional UI fallback before /api/auth/demo-status loads
# VITE_DEMO_AUTH=true         # local only — unlocks admin Demo@123456

# Optional: API base URL (leave empty on Vercel — uses same origin /api)
# VITE_API_URL=http://localhost:3000
