# -------------------------------------------------------------
# Stage 1: Build the Vite React frontend
# -------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace manifests
COPY package.json package-lock.json tsconfig.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/web/tsconfig.json ./apps/web/

# Install dependencies for building
RUN npm install

# Copy web app source files
COPY apps/web/src ./apps/web/src
COPY apps/web/public ./apps/web/public
COPY apps/web/index.html ./apps/web/
COPY apps/web/vite.config.ts ./apps/web/

# Set production frontend build environment
ENV VITE_USE_API=true
ENV VITE_API_URL=
# Feature flag (build-time): set --build-arg ENABLE_ENDPOINT_SECURITY=true to enable
ARG ENABLE_ENDPOINT_SECURITY=false
ENV VITE_ENABLE_ENDPOINT_SECURITY=$ENABLE_ENDPOINT_SECURITY

# Build production bundle
RUN npm run build --prefix apps/web

# -------------------------------------------------------------
# Stage 2: Serve using lightweight Nginx
# -------------------------------------------------------------
FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
