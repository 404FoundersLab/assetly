# =============================================================================
# Solum Technologies — On-Premises Environment Configuration
# =============================================================================
# Copy this file to .env.solum on your on-prem server before starting the app.

# Port on the host machine where the Solum web application will be accessible
# Use 80 for default HTTP, or 8080/3001 if port 80 is already in use
SOLUM_PORT=80

# Database Configuration (Used by solum-postgres container and solum-api)
POSTGRES_USER=solum_admin
POSTGRES_PASSWORD=ChangeThisPasswordInProduction_Solum2026!
POSTGRES_DB=assetly_solum
POSTGRES_PORT=5432

# Authentication & Security Secrets (Generate random 32-character strings)
JWT_SECRET=change-this-jwt-secret-in-production-solum
AGENT_SECRET=change-this-agent-secret-in-production-solum

# Production ERP mode settings (Keep false so employees use secure credentials)
DEMO_AUTH_ENABLED=false
PORTFOLIO_GUEST_ENABLED=false

# Optional: Gemini Chatbot AI key for internal IT Assistant
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-2.5-flash-lite

# Endpoint Security UI module (build-time). true = show, false = hidden. Rebuild web image after changing.
ENABLE_ENDPOINT_SECURITY=false
